load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_utils_buf//:buf.bzl", "buf_format", "buf_generate", "buf_lint_test", "buf_module")
load("//bazel:compat.bzl", "NOT_WINDOWS", "NOT_WINDOWS_ARM64")

filegroup(
    name = "protos",
    srcs = glob(["**/*.proto"]),
    visibility = ["//visibility:public"],
)

buf_module(
    name = "module",
    srcs = [":protos"],
    visibility = ["//visibility:public"],
)

buf_lint_test(
    name = "lint",
    size = "small",
    module = ":module",
    target_compatible_with = NOT_WINDOWS,
)

buf_format(
    name = "format",
    module = ":module",
)

# buffa messages plus both Contract layouts, from the plugin built here.
buf_generate(
    name = "golden",
    module = ":module",
    plugins = ["//rust/protoc-gen-contract-rust"],
    target_compatible_with = NOT_WINDOWS_ARM64,
    template = "//:buf.gen.golden.yaml",
)

# `bazel run //proto:generate` refreshes the golden files;
# `bazel test //proto:all` fails while they differ from the plugin's output.
write_source_files(
    name = "generate",
    check_that_out_file_exists = False,
    files = {
        "//rust/golden:src/generated": ":golden",
    },
    target_compatible_with = NOT_WINDOWS_ARM64,
)
