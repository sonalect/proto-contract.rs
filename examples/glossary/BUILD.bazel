load("@bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@bazel_utils_buf//:buf.bzl", "buf_generate")

# Staged with the test protos in //proto:module, which also lints and
# formats them.
filegroup(
    name = "protos",
    srcs = glob(["proto/**/*.proto"]),
    visibility = ["//proto:__pkg__"],
)

# The example's messages and traits, from the plugin built here.
buf_generate(
    name = "generated",
    module = "//proto:module",
    plugins = ["//rust/protoc-gen-protocontract-buffa"],
    template = "buf.gen.yaml",
)

# `bazel run //examples/glossary:generate` refreshes `api/src/generated`;
# `bazel test //examples/glossary:all` fails while it differs from the
# plugin's output.
write_source_files(
    name = "generate",
    check_that_out_file_exists = False,
    files = {
        "//examples/glossary/api:src/generated": ":generated",
    },
)
