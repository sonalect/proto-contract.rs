load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "contract",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["tokio"],
    crate_name = "contract",
    visibility = ["//visibility:public"],
    deps = [
        "@contract_cargo//:buffa-types",
        "@contract_cargo//:futures-core",
        "@contract_cargo//:tokio",
    ],
)

rust_test(
    name = "contract_test",
    crate = ":contract",
    crate_features = ["tokio"],
    visibility = ["//rust:__pkg__"],
)

rust_doc_test(
    name = "contract_doc_test",
    crate = ":contract",
    crate_features = ["tokio"],
)

# The default feature set: no tokio, no bridges that need it.
rust_library(
    name = "contract_no_tokio",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "contract",
    visibility = ["//rust:__pkg__"],
    deps = [
        "@contract_cargo//:buffa-types",
        "@contract_cargo//:futures-core",
    ],
)

rust_test(
    name = "contract_no_tokio_test",
    crate = ":contract_no_tokio",
    visibility = ["//rust:__pkg__"],
)
