load("@rules_rust//rust:defs.bzl", "rust_doc_test", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "contratto",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["tokio"],
    crate_name = "contratto",
    visibility = ["//visibility:public"],
    deps = [
        "@contratto_cargo//:buffa-types",
        "@contratto_cargo//:futures-core",
        "@contratto_cargo//:tokio",
    ],
)

rust_test(
    name = "contratto_test",
    crate = ":contratto",
    crate_features = ["tokio"],
    visibility = ["//rust:__pkg__"],
)

rust_doc_test(
    name = "contratto_doc_test",
    crate = ":contratto",
    crate_features = ["tokio"],
)

# The default feature set: no tokio, no bridges that need it.
rust_library(
    name = "contratto_no_tokio",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "contratto",
    visibility = ["//rust:__pkg__"],
    deps = [
        "@contratto_cargo//:buffa-types",
        "@contratto_cargo//:futures-core",
    ],
)

rust_test(
    name = "contratto_no_tokio_test",
    crate = ":contratto_no_tokio",
    visibility = ["//rust:__pkg__"],
)
