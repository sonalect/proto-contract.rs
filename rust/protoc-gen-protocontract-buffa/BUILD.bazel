load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

exports_files(["Cargo.toml"])

rust_library(
    name = "lib",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "protoc_gen_protocontract_buffa",
    visibility = ["//rust:__pkg__"],
    deps = [
        "@protocontract_buffa_cargo//:buffa",
        "@protocontract_buffa_cargo//:buffa-codegen",
        "@protocontract_buffa_cargo//:heck",
        "@protocontract_buffa_cargo//:prettyplease",
        "@protocontract_buffa_cargo//:proc-macro2",
        "@protocontract_buffa_cargo//:quote",
        "@protocontract_buffa_cargo//:syn",
    ],
)

rust_test(
    name = "lib_test",
    size = "small",
    crate = ":lib",
    visibility = ["//rust:__pkg__"],
)

# The target name is the name `buf generate` looks up on PATH.
rust_binary(
    name = "protoc-gen-protocontract-buffa",
    srcs = ["src/main.rs"],
    visibility = ["//visibility:public"],
    deps = [
        ":lib",
        "@protocontract_buffa_cargo//:buffa",
    ],
)
