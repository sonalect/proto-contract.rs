load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

exports_files([
    "Cargo.toml",
    # Destination of //proto:generate.
    "src/generated",
])

rust_library(
    name = "golden",
    srcs = glob(["src/**/*.rs"]),
    crate_features = ["tokio"],
    crate_name = "contratto_golden",
    visibility = ["//rust:__pkg__"],
    deps = [
        "//rust/contratto",
        "@contratto_cargo//:buffa",
        "@contratto_cargo//:buffa-types",
        "@contratto_cargo//:connectrpc",
    ],
)

# Without the crate's `tokio` feature: the `file_per_package` bridges,
# gated by `gate_tokio_feature`, compile out.
rust_library(
    name = "golden_no_tokio",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "contratto_golden",
    visibility = ["//rust:__pkg__"],
    deps = [
        "//rust/contratto",
        "@contratto_cargo//:buffa",
        "@contratto_cargo//:buffa-types",
        "@contratto_cargo//:connectrpc",
    ],
)

[
    rust_test(
        name = test + "_test",
        srcs = ["tests/" + test + ".rs"],
        visibility = ["//rust:__pkg__"],
        deps = [
            ":golden",
            "//rust/contratto",
            "@contratto_cargo//:buffa-types",
            "@contratto_cargo//:tokio",
        ],
    )
    for test in [
        "bridges",
        "direct",
        "streaming",
    ]
]
